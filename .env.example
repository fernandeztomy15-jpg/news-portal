# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
# Usar la SERVICE ROLE key (no la anon key): este script escribe en la tabla
# desde un entorno de servidor/CI, no desde el browser.
SUPABASE_SERVICE_ROLE_KEY=

# Timeout por fuente, en ms. Si una fuente no responde en este tiempo,
# se descarta ESA fuente y el resto del run sigue.
FETCH_TIMEOUT_MS=15000
