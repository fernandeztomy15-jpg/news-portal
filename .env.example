# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
# Usar la SERVICE ROLE key (no la anon key): este script escribe en la tabla
# desde un entorno de servidor/CI, no desde el browser.
SUPABASE_SERVICE_ROLE_KEY=

# Timeout por fuente, en ms. Si una fuente no responde en este tiempo,
# se descarta ESA fuente y el resto del run sigue.
FETCH_TIMEOUT_MS=15000

# Anthropic — console.anthropic.com. Usar una API key con el tope de gasto
# mensual de $5 configurado en la consola (Settings > Limits), no una key
# sin límite: la curación corre en un cron y no debe poder generar una
# factura sorpresa si algo se descontrola.
ANTHROPIC_API_KEY=
